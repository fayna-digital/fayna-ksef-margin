<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pivot view — liczenie i sumy wg statusów -->
    <record id="view_ksef_pivot" model="ir.ui.view">
        <field name="name">ksef.invoices.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="KSeF — Statystyki" disable_linking="0">
                <field name="l10n_pl_ksef_status" type="row" />
                <field name="invoice_date" type="col" interval="month" />
                <field name="amount_total" type="measure" />
                <field name="id" type="measure" string="Liczba" />
            </pivot>
        </field>
    </record>

    <!-- Graph view — wykres wg statusów -->
    <record id="view_ksef_graph" model="ir.ui.view">
        <field name="name">ksef.invoices.graph</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <graph string="KSeF — Wykres" type="bar" stacked="0">
                <field name="l10n_pl_ksef_status" type="row" />
                <field name="amount_total" type="measure" />
            </graph>
        </field>
    </record>

    <!-- List view — ostatnie wysyłki -->
    <record id="view_ksef_sent_invoices_tree" model="ir.ui.view">
        <field name="name">ksef.sent.invoices.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree default_order="write_date desc"
                decoration-success="l10n_pl_ksef_status == 'accepted'"
                decoration-warning="l10n_pl_ksef_status == 'waiting'"
                decoration-danger="l10n_pl_ksef_status == 'rejected'"
                decoration-muted="l10n_pl_ksef_status == 'draft'">
                <field name="name" string="Faktura" />
                <field name="invoice_date" string="Data" />
                <field name="partner_id" string="Klient" />
                <field name="amount_total" string="Kwota" widget="monetary" />
                <field name="currency_id" column_invisible="1" />
                <field name="l10n_pl_ksef_status" string="Status KSeF" />
                <field name="l10n_pl_ksef_reference" string="Nr KSeF" />
                <field name="write_date" string="Zaktualizowano" />
            </tree>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_ksef_dashboard_search" model="ir.ui.view">
        <field name="name">ksef.dashboard.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Wyszukiwanie KSeF">
                <filter name="ksef_accepted" string="Zaakceptowano"
                    domain="[('l10n_pl_ksef_status','=','accepted')]" />
                <filter name="ksef_waiting" string="Oczekuje"
                    domain="[('l10n_pl_ksef_status','=','waiting')]" />
                <filter name="ksef_rejected" string="Odrzucono"
                    domain="[('l10n_pl_ksef_status','=','rejected')]" />
                <filter name="ksef_not_sent" string="Nie wysłano"
                    domain="[('l10n_pl_ksef_status','=','draft')]" />
                <separator />
                <filter name="this_month" string="Ten miesiąc"
                    domain="[('invoice_date','>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]" />
                <group expand="0" string="Grupuj">
                    <filter name="group_by_status" string="Wg statusu KSeF"
                        context="{'group_by':'l10n_pl_ksef_status'}" />
                    <filter name="group_by_partner" string="Wg klienta"
                        context="{'group_by':'partner_id'}" />
                    <filter name="group_by_month" string="Wg miesiąca"
                        context="{'group_by':'invoice_date:month'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Akcja dashboardu — OWL client action (pełny KSeF Dashboard) -->
    <record id="action_ksef_main" model="ir.actions.client">
        <field name="name">KSeF — Dashboard</field>
        <field name="tag">ksef_dashboard</field>
    </record>

    <!-- Akcja bezpośredniego dostępu do listy faktur KSeF (używana z dashboardu) -->
    <record id="action_ksef_dashboard" model="ir.actions.act_window">
        <field name="name">KSeF — Faktury</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="domain">
            [('move_type','in',['out_invoice','out_refund']),('state','=','posted')]</field>
        <field name="search_view_id" ref="view_ksef_dashboard_search" />
        <field name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_ksef_sent_invoices_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_ksef_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_ksef_graph')}),
        ]" />
    </record>

    <!-- Menu -->
    <menuitem id="menu_ksef_dashboard"
        name="Dashboard"
        parent="menu_ksef_root"
        action="action_ksef_main"
        sequence="1" />

</odoo>
